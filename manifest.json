{
  "manifest_version": 3,
  "name": "Immotop Companion",
  "version": "0.3.0",
  "description": "Masquez les annonces d'un vendeur ou d'une agence sur les résultats de recherche immotop.lu",
  "action": {
    "default_popup": "src/popup/index.html",
    "default_title": "Immotop Companion — Vendeurs bloqués"
  },
  "background": {
    "service_worker": "src/background/index.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://www.immotop.lu/*", "https://immotop.lu/*"],
      "js": ["src/content/index.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "public/icons/icon16.png",
    "48": "public/icons/icon48.png",
    "128": "public/icons/icon128.png"
  },
  "permissions": ["storage"]
}
